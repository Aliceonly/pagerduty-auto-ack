# PagerDuty Auto-Ack Configuration
# Copy this file to config.toml and fill in your values.

# Required: PagerDuty user-level API key (starts with u+)
pagerduty_api_key = "u+your_api_key_here"

# Optional: check interval in seconds (default: 60)
interval = 60

# Optional: filter by urgency, e.g. ["high"] or ["high", "low"] (default: [] = all)
urgencies = []

# Optional: "ack" or "resolve" (default: "ack")
action = "ack"

# Optional: process all incidents, not just those assigned to you (default: false)
all_incidents = false

# Optional: PagerDuty schedule ID; only process incidents when you are on-call
# schedule_id = "P..."

# Optional: team IDs to skip during HKT night shift (01:30~08:30).
# During the night shift, incidents whose teams[].id matches any of these will
# NOT be auto-ack'd or auto-resolved — leave them for the on-call human.
# Example: ["PXXXXXX"]  # Support Team (P0)
night_shift_excluded_team_ids = ["P8ALLOI"]

# Rate-limit cooldown is hard-coded:
#   if more than 10 incidents are processed within a rolling 60 minutes,
#   auto-ack/resolve pauses for 30 minutes.
